<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sanketa"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btn_power"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_lock_power_off"
            android:background="@drawable/widget_button_bg"
            android:scaleType="centerInside"
            android:contentDescription="Power"
            android:layout_margin="4dp"/>

        <ImageButton
            android:id="@+id/btn_vol_up"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_ff"
            android:background="@drawable/widget_button_bg"
            android:scaleType="centerInside"
            android:contentDescription="Volume Up"
            android:layout_margin="4dp"/>

        <ImageButton
            android:id="@+id/btn_vol_down"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_rew"
            android:background="@drawable/widget_button_bg"
            android:scaleType="centerInside"
            android:contentDescription="Volume Down"
            android:layout_margin="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <ImageButton
            android:id="@+id/btn_mute"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_lock_silent_mode"
            android:background="@drawable/widget_button_bg"
            android:scaleType="centerInside"
            android:contentDescription="Mute"
            android:layout_margin="4dp"/>

        <ImageButton
            android:id="@+id/btn_home"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_compass"
            android:background="@drawable/widget_button_bg"
            android:scaleType="centerInside"
            android:contentDescription="Home"
            android:layout_margin="4dp"/>

        <ImageButton
            android:id="@+id/btn_open"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="@drawable/widget_button_bg"
            android:scaleType="centerInside"
            android:contentDescription="Open Sanketa"
            android:layout_margin="4dp"/>
    </LinearLayout>
</LinearLayout>
